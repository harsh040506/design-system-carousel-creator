"""
__PROJECT_NAME__ -- library builder.

Generated by `scaffold.py builder`. This file is the SOURCE of the library; the
.dc.html is its output. Edit here, run this, look at the canvas.

    python build.py                 rebuild
    python build.py --verify        rebuild, then check the envelope
    dscc.py preview --watch        rebuild automatically and reload the canvas

────────────────────────────────────────────────────────────────────────────────
WHY THIS FILE EXISTS AT ALL

A 121 KB hand-edited HTML file with no source is a liability. The same file with a
generator beside it is an asset: the type ramp is nine numbers in one place, a
ground is a dictionary, and a fix to a shared row shape reaches all fifty cards
instead of the eleven you remembered to edit.

THE ONE RULE YOU MUST NOT BREAK

main() always re-runs scaffold init from scratch. It does NOT patch the existing
document. Patching in place makes the style layer sticky -- the usual shape is

    if "BRAND LAYER" not in doc:      # <- looks sensible, is a trap
        doc = insert_css(doc)

and after the first successful build that condition is never true again, so every
later edit to the CSS silently does not reach the output. The failure looks
exactly like the edit not working, which is why it costs a full debugging cycle
rather than five minutes. Re-scaffolding is cheap. Do that.

ORDERING ALSO MATTERS

Ground tokens go into :root BEFORE the CSS layer is inserted. Inserting the CSS
first and then guarding the token injection with `if "--tok" not in doc` matches
the CSS layer's own var(--tok) usages, so the tokens are never written and you get
a screen of UNDECLARED_VAR P0s pointing at a file that looks correct.
────────────────────────────────────────────────────────────────────────────────
"""
from __future__ import annotations

import argparse
import json
import os
import pathlib
import re
import subprocess
import sys

HERE = pathlib.Path(__file__).resolve().parent          # <project>/build
PROJECT = HERE.parent


def find_plugin() -> pathlib.Path:
    """Locate the plugin without trusting a path baked in at scaffold time.

    A plugin update or move would otherwise leave every existing project pointing
    at a directory that no longer exists. Order: an explicit override, the
    variable Claude Code sets for a running plugin, the path recorded when this
    file was generated (kept as a hint, not an assumption).
    """
    candidates = [os.environ.get("DSCC_PLUGIN_ROOT"),
                  os.environ.get("CLAUDE_PLUGIN_ROOT"),
                  r"__PLUGIN_ROOT__"]
    for c in candidates:
        if c and (pathlib.Path(c) / "scripts" / "scaffold.py").exists():
            return pathlib.Path(c)
    sys.exit("cannot find the Design System Carousel Creator plugin.\n"
             f"  last known location: {candidates[-1]}\n"
             "  set DSCC_PLUGIN_ROOT to the plugin folder (the one holding scripts/scaffold.py)")


PLUGIN = find_plugin()
SCAFFOLD = PLUGIN / "scripts" / "scaffold.py"
KERNEL = PLUGIN / "skills" / "carousel-craft" / "assets" / "kernel.css"

SYSTEM_PATH = HERE / "design-system.json"
PLAN_PATH = HERE / "layout-plan.json"
BRIEF_PATH = HERE / "content-brief.json"
DOC = PROJECT / "__LIBRARY_REL_STR__"

SYSTEM = json.loads(SYSTEM_PATH.read_text(encoding="utf-8")) if SYSTEM_PATH.exists() else {}
PLAN = json.loads(PLAN_PATH.read_text(encoding="utf-8")) if PLAN_PATH.exists() else {"cards": []}
BRIEF = json.loads(BRIEF_PATH.read_text(encoding="utf-8")) if BRIEF_PATH.exists() else {"claims": []}
CLAIMS = {c["id"]: c for c in BRIEF.get("claims", [])}

SCAFFOLD_ARGS = [
    str(DOC),
    "--system", str(SYSTEM_PATH),
    "--title", "__PROJECT_NAME_STR__",
    "--cols", "__COLS__",
    "--fonts", "__FONTS_STR__",
    "--no-builder",
]

# ── brand layer ─────────────────────────────────────────────────────────────
# Everything the kernel deliberately does not know: this brand's grounds, its
# motif, its one-off geometry. Kept as one string so a single edit reaches the
# whole library.
BRAND_CSS = """
/* ═══ __PROJECT_NAME__ — BRAND LAYER ═══════════════════════════════════════ */

/* Ground classes remap role tokens on .frame, so one card markup shape works on
   every surface. Five grounds minimum across the library — it is the single
   highest-leverage move for perceived range. */
"""

# Theme-swapped tokens. EVERY colour used in card markup belongs in both maps.
# A colour declared once in :root and used on cards cannot follow the theme, so on
# a two-theme document it is provably wrong in one of them — the linter emits
# MONO_THEME_TOKEN for exactly this, after a motif spent a whole run being a dark
# disc under dark type in one theme and the mirror of that in the other.
TOKENS_DARK: dict[str, str] = {}
TOKENS_LIGHT: dict[str, str] = {}


# ── card composition ────────────────────────────────────────────────────────
def card(spec: dict) -> str:
    """Render one card from its plan entry.

    The data-* attributes are not decoration. They are how the auditor checks the
    build against the plan: data-mechanic makes layout collisions detectable,
    data-intent/data-license make bottom slack adjudicable, data-claim makes
    veracity a lookup instead of a memory.
    """
    idx = spec.get("index", 0)
    layout = spec.get("layout", "card")
    label = f"{idx:02d} · {layout}"
    body = compose(spec)                     # <- the interesting half
    lic = f' data-license="{attr(spec["license"])}"' if spec.get("license") else ""
    return f"""
  <div style="display:flex;flex-direction:column;gap:18px">
    <div class="gallery-label" style="display:var(--label-vis)">{esc(label)}</div>
    <div class="{('frame ' + ground_class(spec)).strip()}" data-card="{idx:02d}"
         data-layout="{attr(layout)}"
         data-mechanic="{attr(mechanic_of(spec))}"
         data-intent="{attr(spec.get('intent', 'fill'))}"{lic}
         data-claim="{attr(' '.join(spec.get('claims', [])))}">
{body}
    </div>
  </div>"""


AXES = ("partition", "flow", "enumerator", "emphasis", "media", "chrome")


def mechanic_of(spec: dict) -> str:
    """partition:flow:enumerator:emphasis:media:chrome, the string uniq.py reads.

    The plan schema makes `mechanic` optional and requires the six axes, so derive
    it. Emitting an empty data-mechanic would put the whole library into the
    uniqueness check's degraded mode, where it can only guess a ground from CSS
    class names and every collision check is skipped.
    """
    if spec.get("mechanic"):
        return spec["mechanic"]
    if all(a in spec for a in AXES):
        return ":".join(str(spec[a]) for a in AXES)
    return ""


def ground_class(spec: dict) -> str:
    """The surface ground class: g-<chrome>, e.g. g-panel, g-accent-1.

    The plan field is `chrome` (the sixth axis of the mechanic tuple). Ground
    classes remap the role tokens on .frame, and BRAND_CSS is where they are
    defined. `paper` is the default ground and needs no class.
    """
    g = spec.get("chrome") or spec.get("ground") or ""
    g = {"standard": "paper", "plate": "ink", "tinted": "panel"}.get(g, g)   # legacy names
    if g == "flush":
        return "flush"                     # full-bleed media: the kernel's .frame.flush
    return "" if g in ("", "paper") else f"g-{g}"


def compose(spec: dict) -> str:
    """TODO: build the card body from spec['mechanic'] and its claims.

    Rules that are not negotiable while you write this:
      · no raw px, no raw hex, no inline font-size — everything through a token
      · min-width:0 on every flex child holding text, or long copy walks out of
        the frame on the twenty-first card and not before
      · a sparse card is UNDER-WRITTEN, not over-spaced. Pull another claim from
        the unused pool; never distribute slack with space-between
      · concluding lines use .note so they read as a coda, not as another row
    """
    parts = [txt(CLAIMS[c]["text"]) for c in spec.get("claims", []) if c in CLAIMS]
    return "\n".join(parts) or '      <div class="body-lg">—</div>'


def txt(s: str, cls: str = "body-lg") -> str:
    return f'      <div class="{cls}" style="min-width:0">{esc(s)}</div>'


def esc(s: str) -> str:
    """Escape for HTML — and never with numeric entities.

    `&#9671;` survives tag-stripping in the auditor's text extractor as the digits
    9671, which the veracity check reads as a figure absent from the brief. One
    decorative lozenge produced fifty P0 INVENTED_FIGURE defects and a failed gate.
    Write the literal character; the document is UTF-8.
    """
    return (s.replace("&", "&amp;").replace("<", "&lt;").replace(">", "&gt;"))


def attr(s: object) -> str:
    """Escape for a double-quoted attribute value (same no-numeric-entity rule)."""
    return esc(str(s)).replace('"', "&quot;")


# ── assembly ────────────────────────────────────────────────────────────────
def inject_tokens(doc: str, tokens: dict[str, str]) -> str:
    """Add tokens to the existing :root block. Must run BEFORE the CSS insert.

    :root carries the LIGHT defaults (the same map the scaffold seeds it with);
    applyTheme() overrides every key at runtime for the dark theme.
    """
    if not tokens:
        return doc
    lines = "".join(f"    {k}: {v};\n" for k, v in tokens.items())
    return doc.replace("    letter-spacing: normal;", lines + "    letter-spacing: normal;", 1)


def insert_css(doc: str) -> str:
    kernel = KERNEL.read_text(encoding="utf-8") if KERNEL.exists() else ""
    if not kernel:
        print("  ! kernel.css not found — the library will have no primitive layer")
    return doc.replace("</style>", "\n" + kernel + "\n" + BRAND_CSS + "\n" + artboard_css() + "\n</style>", 1)


def artboard_css() -> str:
    """The real artboard size, declared AFTER the kernel.

    The kernel ships a default --card-w/--card-h in its own :root. Same selector,
    later wins, so a project whose canvas is not the kernel's default would
    otherwise render every frame at the wrong height and be measured against it.
    """
    cv = SYSTEM.get("canvas") or {}
    if not (cv.get("width") and cv.get("height")):
        try:
            cv = json.loads((PROJECT / "project.json").read_text(encoding="utf-8")).get("canvas") or {}
        except (OSError, ValueError):
            cv = {}
    w, h = int(cv.get("width") or 1080), int(cv.get("height") or 1440)
    return f":root{{--card-w:{w}px;--card-h:{h}px}}"


def insert_theme(doc: str) -> str:
    """Replace the scaffold's theme maps with this brand's, keeping the default."""
    if not TOKENS_DARK and not TOKENS_LIGHT:
        return doc

    def obj(d: dict[str, str]) -> str:
        return json.dumps({k.lstrip("-"): v for k, v in d.items()}, ensure_ascii=False)

    doc = re.sub(r"const v = dark \? \{.*?\} : \{.*?\};",
                 f"const v = dark ? {obj(TOKENS_DARK)} : {obj(TOKENS_LIGHT)};",
                 doc, count=1, flags=re.S)
    return doc.replace('"default": "White"', '"default": "__DEFAULT_THEME__"') \
              .replace("&quot;default&quot;: &quot;White&quot;",
                       "&quot;default&quot;: &quot;__DEFAULT_THEME__&quot;")


def insert_cards(doc: str, cards_html: str) -> str:
    marker = "<!-- CARDS GO HERE -->"
    if marker not in doc:
        sys.exit("scaffold marker missing — the envelope is not what this builder expects")
    return doc.replace(marker, cards_html, 1)


def main() -> None:
    ap = argparse.ArgumentParser(description=__doc__.split("\n")[1])
    ap.add_argument("--verify", action="store_true")
    a = ap.parse_args()

    # 1 · ALWAYS re-scaffold. See the header. This is not an optimisation to undo.
    DOC.parent.mkdir(parents=True, exist_ok=True)
    r = subprocess.run([sys.executable, str(SCAFFOLD), "init", *SCAFFOLD_ARGS],
                       capture_output=True, text=True)
    if r.returncode != 0:
        sys.exit(f"scaffold failed:\n{r.stderr or r.stdout}")
    doc = DOC.read_text(encoding="utf-8")

    # 2 · tokens into :root, BEFORE the CSS layer. Order is load-bearing.
    doc = inject_tokens(doc, TOKENS_LIGHT)

    # 3 · kernel verbatim + the brand layer
    doc = insert_css(doc)

    # 4 · theme maps and the default
    doc = insert_theme(doc)

    # 5 · cards
    specs = PLAN.get("cards", [])
    html = "\n".join(card(s) for s in specs)
    doc = insert_cards(doc, html)

    # A numeric entity anywhere is a figure the veracity check will invent.
    bad = re.findall(r"&#\d+;", doc)
    assert not bad, f"numeric HTML entities present: {sorted(set(bad))[:5]} — use literals"

    DOC.write_text(doc, encoding="utf-8")
    print(f"built {len(specs)} cards -> {DOC.relative_to(PROJECT)}  ({len(doc) // 1024} KB)")

    if a.verify:
        sys.exit(subprocess.run([sys.executable, str(SCAFFOLD), "verify", str(DOC)]).returncode)


if __name__ == "__main__":
    main()
